{"cells":[{"cell_type":"code","execution_count":null,"metadata":{"colab":{"background_save":true,"base_uri":"https://localhost:8080/"},"id":"o18HGIWLjGY1"},"outputs":[{"name":"stdout","output_type":"stream","text":["Checking NLTK resources...\n","NLTK resource check complete.\n"]},{"name":"stderr","output_type":"stream","text":["/usr/local/lib/python3.12/dist-packages/sklearn/feature_extraction/text.py:517: UserWarning: The parameter 'token_pattern' will not be used since 'tokenizer' is not None'\n","  warnings.warn(\n"]},{"name":"stdout","output_type":"stream","text":["INFO: Model retrained successfully.\n","Starting Flask app...\n"," * Serving Flask app '__main__'\n"," * Debug mode: on\n"]},{"name":"stderr","output_type":"stream","text":["INFO:werkzeug:\u001b[31m\u001b[1mWARNING: This is a development server. Do not use it in a production deployment. Use a production WSGI server instead.\u001b[0m\n"," * Running on http://127.0.0.1:5000\n","INFO:werkzeug:\u001b[33mPress CTRL+C to quit\u001b[0m\n","INFO:werkzeug: * Restarting with watchdog (inotify)\n"]}],"source":["from flask import Flask, render_template_string, request, jsonify\n","import nltk\n","import numpy as np\n","import string\n","import sys\n","from nltk.stem import WordNetLemmatizer\n","from sklearn.feature_extraction.text import TfidfVectorizer\n","from sklearn.metrics.pairwise import cosine_similarity\n","\n","# --- 1. Konfigurasi Awal \u0026 Log ---\n","print(\"Checking NLTK resources...\")\n","resources = ['punkt', 'wordnet', 'omw-1.4', 'punkt_tab']\n","for res in resources:\n","    try:\n","        nltk.data.find(f'tokenizers/{res}')\n","    except LookupError:\n","        nltk.download(res, quiet=True)\n","print(\"NLTK resource check complete.\")\n","\n","app = Flask(__name__)\n","\n","# --- 2. Data \u0026 Logika Chatbot (Sama seperti sebelumnya) ---\n","lemmatizer = WordNetLemmatizer()\n","\n","# Data Default\n","default_corpus = \"\"\"Jam kerja perusahaan dimulai pukul 08.00 WIB dan berakhir pukul 17.00 WIB hari Senin sampai Jumat.\n","Karyawan wajib melakukan presensi kehadiran menggunakan sidik jari atau aplikasi mobile saat datang dan pulang.\n","Selamat pagi, ada yang bisa saya bantu untuk menjawab peraturan perusahaan.\n","Keterlambatan lebih dari 15 menit akan dikenakan pemotongan tunjangan kehadiran.\n","Pakaian kerja hari Senin sampai Kamis adalah kemeja rapi atau seragam kantor.\n","Pakaian kerja hari Jumat adalah batik atau pakaian kasual yang sopan.\n","Cuti tahunan diberikan sebanyak 12 hari kerja setelah karyawan bekerja selama 1 tahun berturut-turut.\n","Pengajuan cuti harus dilakukan minimal 3 hari sebelum tanggal cuti melalui sistem HRIS.\n","Izin sakit harus disertai dengan surat keterangan dokter yang sah.\n","Lembur hanya dihitung jika ada surat perintah lembur dari atasan.\n","Karyawan mendapatkan gaji tiap tanggal 27 setiap bulan.\n","Setiap akhir tahun perusahaan akan memberikan bonus kepada karyawan yang berprestasi melebihi target.\n","Karyawan berhak mendapatkan tunjangan kesehatan dan BPJS Ketenagakerjaan.\n","Dilarang merokok di dalam ruang kerja, merokok hanya diperbolehkan di area khusus merokok.\n","Setiap karyawan wajib menjaga kerahasiaan data perusahaan.\"\"\"\n","\n","# Variabel Global untuk menyimpan model\n","current_corpus = default_corpus\n","vectorizer = None\n","tfidf_matrix = None\n","sentences = []\n","\n","def clean_text(text):\n","    text = text.lower()\n","    text = text.translate(str.maketrans('', '', string.punctuation))\n","    tokens = nltk.word_tokenize(text)\n","    tokens = [lemmatizer.lemmatize(word) for word in tokens]\n","    return \" \".join(tokens)\n","\n","def train_model():\n","    global vectorizer, tfidf_matrix, sentences, current_corpus\n","    sentences = nltk.sent_tokenize(current_corpus)\n","    vectorizer = TfidfVectorizer(tokenizer=lambda x: x.split(), preprocessor=clean_text)\n","    tfidf_matrix = vectorizer.fit_transform(sentences)\n","    print(\"INFO: Model retrained successfully.\")\n","\n","# Train pertama kali saat aplikasi mulai\n","train_model()\n","\n","# --- 3. Tampilan Dashboard (HTML/CSS/JS) ---\n","# Disimpan dalam variabel string agar Anda tidak perlu membuat file HTML terpisah\n","HTML_TEMPLATE = \"\"\"\n","\u003c!DOCTYPE html\u003e\n","\u003chtml lang=\"id\"\u003e\n","\u003chead\u003e\n","    \u003cmeta charset=\"UTF-8\"\u003e\n","    \u003cmeta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"\u003e\n","    \u003ctitle\u003eDashboard Chatbot Admin\u003c/title\u003e\n","    \u003clink href=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css\" rel=\"stylesheet\"\u003e\n","    \u003cstyle\u003e\n","        body { background-color: #f4f6f9; height: 100vh; overflow: hidden; }\n","        .container-fluid { height: 100%; padding: 0; }\n","        .sidebar { background-color: #2c3e50; color: white; height: 100vh; padding: 20px; overflow-y: auto; }\n","        .chat-area { height: 100vh; display: flex; flex-direction: column; background: white; }\n","        .chat-history { flex: 1; padding: 20px; overflow-y: auto; background-color: #f8f9fa; }\n","        .chat-input-area { padding: 20px; border-top: 1px solid #dee2e6; background: white; }\n","        .message { margin-bottom: 15px; max-width: 80%; padding: 10px 15px; border-radius: 15px; }\n","        .user-msg { background-color: #007bff; color: white; margin-left: auto; border-bottom-right-radius: 0; }\n","        .bot-msg { background-color: #e9ecef; color: #333; margin-right: auto; border-bottom-left-radius: 0; }\n","        textarea { background: #34495e; color: white; border: none; width: 100%; height: 400px; padding: 10px; border-radius: 5px; }\n","        textarea:focus { outline: none; background: #3d566e; color: white; }\n","    \u003c/style\u003e\n","\u003c/head\u003e\n","\u003cbody\u003e\n","\n","\u003cdiv class=\"container-fluid\"\u003e\n","    \u003cdiv class=\"row g-0\"\u003e\n","        \u003c!-- Sidebar: Editor Aturan --\u003e\n","        \u003cdiv class=\"col-md-4 sidebar\"\u003e\n","            \u003ch3\u003e⚙️ Admin Panel\u003c/h3\u003e\n","            \u003cp class=\"text-muted small\"\u003eEdit aturan di bawah ini untuk mengupdate pengetahuan bot secara real-time.\u003c/p\u003e\n","\n","            \u003clabel class=\"form-label\"\u003eDatabase Aturan (Corpus)\u003c/label\u003e\n","            \u003ctextarea id=\"corpusText\"\u003e{{ corpus }}\u003c/textarea\u003e\n","\n","            \u003cbutton onclick=\"updateModel()\" class=\"btn btn-success w-100 mt-3\"\u003e\n","                💾 Simpan \u0026 Update Model\n","            \u003c/button\u003e\n","            \u003cdiv id=\"updateStatus\" class=\"mt-2 text-warning small\"\u003e\u003c/div\u003e\n","        \u003c/div\u003e\n","\n","        \u003c!-- Main: Chat Interface --\u003e\n","        \u003cdiv class=\"col-md-8 chat-area\"\u003e\n","            \u003cdiv class=\"p-3 border-bottom shadow-sm\"\u003e\n","                \u003ch4 class=\"m-0\"\u003e🤖 Preview Chatbot HRD\u003c/h4\u003e\n","            \u003c/div\u003e\n","\n","            \u003cdiv id=\"chatHistory\" class=\"chat-history\"\u003e\n","                \u003cdiv class=\"message bot-msg\"\u003e\n","                    Halo! Saya Chatbot HRD. Silakan atur pengetahuan saya di panel kiri, lalu tes tanya jawab di sini.\n","                \u003c/div\u003e\n","            \u003c/div\u003e\n","\n","            \u003cdiv class=\"chat-input-area\"\u003e\n","                \u003cform id=\"chatForm\" class=\"d-flex gap-2\"\u003e\n","                    \u003cinput type=\"text\" id=\"userInput\" class=\"form-control\" placeholder=\"Ketik pertanyaan...\" autocomplete=\"off\"\u003e\n","                    \u003cbutton type=\"submit\" class=\"btn btn-primary\"\u003eKirim\u003c/button\u003e\n","                \u003c/form\u003e\n","            \u003c/div\u003e\n","        \u003c/div\u003e\n","    \u003c/div\u003e\n","\u003c/div\u003e\n","\n","\u003cscript\u003e\n","    // Fungsi Chat\n","    document.getElementById('chatForm').addEventListener('submit', async function(e) {\n","        e.preventDefault();\n","        let input = document.getElementById('userInput');\n","        let message = input.value;\n","        if(!message) return;\n","\n","        // Tampilkan pesan user\n","        addMessage(message, 'user-msg');\n","        input.value = '';\n","\n","        // Kirim ke backend Flask\n","        let response = await fetch('/get_response', {\n","            method: 'POST',\n","            headers: {'Content-Type': 'application/json'},\n","            body: JSON.stringify({msg: message})\n","        });\n","        let data = await response.json();\n","\n","        // Tampilkan balasan bot\n","        addMessage(data.response, 'bot-msg');\n","    });\n","\n","    function addMessage(text, className) {\n","        let div = document.createElement('div');\n","        div.className = `message ${className}`;\n","        div.innerText = text;\n","        document.getElementById('chatHistory').appendChild(div);\n","        document.getElementById('chatHistory').scrollTop = document.getElementById('chatHistory').scrollHeight;\n","    }\n","\n","    // Fungsi Update Model\n","    async function updateModel() {\n","        let newCorpus = document.getElementById('corpusText').value;\n","        let status = document.getElementById('updateStatus');\n","        status.innerText = \"Mengupdate model...\";\n","\n","        let response = await fetch('/update_model', {\n","            method: 'POST',\n","            headers: {'Content-Type': 'application/json'},\n","            body: JSON.stringify({corpus: newCorpus})\n","        });\n","        let data = await response.json();\n","\n","        if(data.success) {\n","            status.innerText = \"✅ Model berhasil diperbarui!\";\n","            setTimeout(() =\u003e status.innerText = \"\", 3000);\n","\n","            // Tambahkan notifikasi di chat\n","            addMessage(\"Sistem: Pengetahuan saya telah diperbarui oleh Admin.\", \"bot-msg\");\n","        }\n","    }\n","\u003c/script\u003e\n","\u003c/body\u003e\n","\u003c/html\u003e\n","\"\"\"\n","\n","# --- 4. Routing Flask ---\n","\n","@app.route('/')\n","def home():\n","    return render_template_string(HTML_TEMPLATE, corpus=current_corpus)\n","\n","@app.route('/get_response', methods=['POST'])\n","def get_bot_response():\n","    user_input = request.json.get('msg')\n","\n","    # Logika Cosine Similarity\n","    user_vec = vectorizer.transform([user_input])\n","    vals = cosine_similarity(user_vec, tfidf_matrix)\n","    idx = vals.argsort()[0][-1]\n","    flat = vals.flatten()\n","    flat.sort()\n","    req_tfidf = flat[-1]\n","\n","    if req_tfidf == 0:\n","        response = \"Maaf, saya tidak menemukan informasi terkait hal tersebut dalam aturan perusahaan.\"\n","    else:\n","        response = sentences[idx]\n","\n","    return jsonify({'response': response})\n","\n","@app.route('/update_model', methods=['POST'])\n","def update_model_route():\n","    global current_corpus\n","    data = request.json\n","    new_corpus = data.get('corpus')\n","\n","    if new_corpus:\n","        current_corpus = new_corpus\n","        train_model() # Retrain ulang model dengan data baru\n","        return jsonify({'success': True})\n","    return jsonify({'success': False})\n","\n","if __name__ == '__main__':\n","    print(\"Starting Flask app...\")\n","    # Menjalankan server\n","    app.run(debug=True, port=5000)"]}],"metadata":{"colab":{"name":"","provenance":[{"file_id":"1mRiRZOcdNgnAF_6B7DgcvXAuYtxspPOP","timestamp":1766214013926}],"version":""},"kernelspec":{"display_name":"Python 3","name":"python3"}},"nbformat":4,"nbformat_minor":0}